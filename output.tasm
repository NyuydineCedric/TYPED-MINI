; =====================================
; TYPED-MINI TARGET ASSEMBLY
; Register-based virtual machine
; =====================================

.FRAME 48 bytes

START:
    LOADI R0, 20
    STORE [FP-8], R0
    LOADI R0, 20
    ITOF R2, R0
    STORE [FP-16], R2
    LOAD R0, [FP-16]
    STORE [FP-24], R0
    LOADI R0, 20
    ITOF R2, R0
    STORE [FP-32], R2
    LOAD R0, [FP-24]
    LOAD R1, [FP-32]
    FADD R2, R0, R1
    STORE [FP-40], R2
    LOAD R0, [FP-40]
    STORE [FP-48], R0

    HALT
