; =====================================
; TYPED-MINI TARGET ASSEMBLY
; Register-based virtual machine
; =====================================

.FRAME 48 bytes

START:
    LOADI R0, 20
    STORE [FP-8], R0
    LOADI R1, 20
    ITOF R2, R1
    STORE [FP-16], R2
    STORE [FP-24], R2
    LOADI R0, 20
    ITOF R1, R0
    STORE [FP-32], R1
    FADD R0, R2, R1
    STORE [FP-40], R0
    STORE [FP-48], R0

    HALT
